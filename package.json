{
  "name": "hermes-agent-platform",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Hermes 多智能体平台",
  "author": "Hermes Agent Platform Team",
  "desktopName": "hermes-agent-platform.desktop",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/src/gui/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsx src/gui/copy-assets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/",
    "lint": "eslint .",
    "hap": "tsx src/cli/bin.ts",
    "rebuild": "npm run rebuild:electron && npm run rebuild:node",
    "rebuild:electron": "electron-rebuild -v 37.10.3 -f -w better-sqlite3 && tsx scripts/ensure-native-addons.ts --electron",
    "rebuild:node": "npm rebuild better-sqlite3 --build-from-source && tsx scripts/ensure-native-addons.ts --node",
    "gui": "npm run build && npm run rebuild:electron && electron dist/src/gui/main.js",
    "gui:dev": "npm run build && npm run rebuild:electron && electron dist/src/gui/main.js",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && npm run rebuild:electron && electron-builder --win --publish never",
    "dist:linux": "npm run build && npm run rebuild:electron && electron-builder --linux deb --publish never",
    "dist:mac": "npm run build && npm run rebuild:electron && electron-builder --mac --publish never",
    "dist:dir": "npm run build && npm run rebuild:electron && electron-builder --dir"
  },
  "build": {
    "appId": "com.hermes.agent.platform",
    "productName": "Hermes Agent Platform",
    "copyright": "Copyright © 2026 Hermes Agent Platform Team",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xukehb",
        "repo": "Hermes-Agent-Platform"
      }
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Hermes-Agent-Platform-${version}-Windows-${arch}-Setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Hermes-Agent-Platform-${version}-Windows-${arch}-Portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "Hermes-Agent-Platform-${version}-macOS-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "Hermes-Agent-Platform-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "target": [
        "deb"
      ],
      "category": "Development",
      "maintainer": "Hermes Agent Platform Team",
      "syncDesktopName": true,
      "artifactName": "Hermes-Agent-Platform-${version}-Ubuntu-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@clack/prompts": "^1.7.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^12.11.1",
    "commander": "^15.0.0",
    "electron-updater": "6.8.9",
    "execa": "^10.0.1",
    "grammy": "^1.45.1",
    "hono": "^4.13.3",
    "openai": "^7.5.0",
    "pino": "^10.3.1",
    "smol-toml": "^1.8.0",
    "ssh2": "^1.17.0",
    "wechaty": "^1.20.2",
    "wechaty-puppet-service": "^1.18.2",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.15.0",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "electron": "^37.3.1",
    "electron-builder": "26.15.3",
    "eslint": "^9.0.0",
    "js-yaml": "4.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
